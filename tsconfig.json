{
  "extends": "./library-frontend/node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "library-frontend/**/*.ts",
    "library-frontend/**/*.tsx"
  ],
  "exclude": [
    "library-frontend/node_modules",
    "library-backend/node_modules"
  ]
}
