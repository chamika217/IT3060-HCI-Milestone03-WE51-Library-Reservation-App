EXPO_PUBLIC_API_HOST=192.168.x.x
# Use your PC's WiFi IPv4 (for example, 192.168.1.15) when running the app on Expo Go from a phone.
# Set this to true only after adding http://localhost:8081 to the OAuth client's
# Authorized JavaScript origins in Google Cloud Console.
EXPO_PUBLIC_ENABLE_GOOGLE_WEB_SIGNIN=false
