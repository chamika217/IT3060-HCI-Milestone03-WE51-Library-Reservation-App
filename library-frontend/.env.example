EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android emulator: http://10.0.2.2:5000/api
# Physical phone in Expo Go: localhost is replaced with the Expo LAN host in development.
# Keep the phone and computer on the same Wi-Fi and start Expo with --lan.
# For tunnels or a deployed app, set an explicit reachable backend URL.
