EXPO_PUBLIC_API_HOST=192.168.x.x
# Optional override. By default the tracked public OAuth configuration is used.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Use your PC's WiFi IPv4 (for example, 192.168.1.15) when running the app on Expo Go from a phone.
# The committed public OAuth configuration enables browser sign-in by default.
# Set false only to disable it on this machine.
EXPO_PUBLIC_ENABLE_GOOGLE_WEB_SIGNIN=true
